# Copy to .env. Never put this key in dist/ or a browser bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_OUTPUT_TOKENS=800
AI_DAILY_REQUEST_LIMIT=100
PORT=3000
HOST=127.0.0.1

# Supabase account integration: server-only values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set production and secure cookies behind HTTPS when deploying the Node server.
NODE_ENV=development
COOKIE_SECURE=false
